      {
        "id": "section-3",
        "name": "Heel flap",
        "notes": "The slipped stitch at the start of every row makes the chain the gusset stitches are picked up from.",
        "construction": "Flat",
        "piece": null,
        "steps": [
          {
            "id": "step-5",
            "action": {
              "WorkFlat": {
                "count": 32,
                "name": "heel flap",
                "slip_edges": true
              }
            }
          },
          {
            "id": "step-6",
            "action": {
              "Rows": {
                "count": 32,
                "text": "on RS rows, *sl 1, k1; rep from * to end; on WS rows, sl 1, p to end"
              }
            }
          }
        ]
      },
