    "notes": "One shoulder sloped in three steps of 6 stitches, then held for a three-needle bind-off.",
    "sections": [
      {
        "id": "section-1",
        "name": "Body",
        "notes": "",
        "construction": null,
        "piece": null,
        "steps": [
          {
            "id": "step-1",
            "action": {
              "ChartRows": {
                "first": 1,
                "last": 2
              }
            }
          },
          {
            "id": "step-2",
            "action": {
              "Opaque": {
                "text": "Repeat rows 1 and 2 until the piece measures 4 in (10 cm) from the cast-on, ending with a WS row.",
                "stitch_change": 0
              }
            }
          }
        ]
      },
      {
        "id": "section-2",
        "name": "Shoulder",
        "notes": "The stitches left at the end of each right-side row become the low end of the slope.",
        "construction": null,
        "piece": null,
        "steps": [
          {
            "id": "step-3",
            "action": {
              "ShortRow": {
                "stitch": "Knit",
                "to": {
                  "Last": 6
                },
                "method": "WrapAndTurn",
                "resolve_turns": false,
                "decrease": null
              }
            }
          },
          {
            "id": "step-4",
            "action": {
              "Work": {
