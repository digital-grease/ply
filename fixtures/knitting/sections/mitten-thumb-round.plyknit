              }
            }
          }
        ]
      },
      {
        "id": "section-2",
        "name": "Hand",
        "notes": "The thumb's 8 stitches go on a holder in the round after the 14 plain rounds; the 8 cast on over them close the opening.",
        "construction": "InTheRound",
        "piece": "piece-1",
        "steps": [
          {
            "id": "step-3",
            "action": {
              "Rows": {
                "count": 14,
                "text": "knit"
              }
            }
          },
          {
            "id": "step-4",
            "action": {
              "Work": {
                "stitch": "Knit",
                "to": {
                  "Count": 2
                },
                "resolve_turns": false
              }
            }
          },
          {
            "id": "step-5",
            "action": {
              "Hold": {
                "count": 8,
                "name": "thumb"
              }
            }
          },
          {
            "id": "step-6",
            "action": {
              "CastOn": {
                "count": 8
              }
            }
          },
          {
            "id": "step-7",
            "action": {
              "Work": {
                "stitch": "Knit",
                "to": "End",
                "resolve_turns": false
              }
            }
          },
          {
            "id": "step-8",
            "action": {
              "Rows": {
                "count": 22,
                "text": "knit"
              }
            }
          }
        ]
      },
      {
        "id": "section-3",
        "name": "Top",
        "notes": "",
        "construction": "InTheRound",
        "piece": "piece-1",
        "steps": [
          {
            "id": "step-9",
            "action": {
              "Groups": {
                "groups": [
                  {
                    "name": "palm",
                    "count": 20,
                    "notes": "needles 1 and 2"
                  },
                  {
                    "name": "back",
                    "count": 20,
                    "notes": "needles 3 and 4"
                  }
                ]
              }
            }
          },
          {
            "id": "step-10",
            "action": {
              "Shape": {
                "change": -2,
                "every": 2,
                "until": {
                  "Remain": 24
                },
                "groups": [
                  "palm",
                  "back"
                ],
                "text": "k1, ssk, knit to last 3 sts of the group, k2tog, k1"
              }
            }
          },
          {
            "id": "step-11",
            "action": {
              "Shape": {
                "change": -2,
                "every": 1,
                "until": {
                  "Remain": 12
                },
                "groups": [
                  "palm",
                  "back"
                ],
                "text": "k1, ssk, knit to last 3 sts of the group, k2tog, k1"
              }
            }
          },
          {
            "id": "step-12",
            "action": {
              "Close": {
                "method": "Graft",
                "holds": []
              }
            }
          }
        ]
      },
      {
        "id": "section-4",
        "name": "Thumb",
        "notes": "Pick up one stitch in each cast-on stitch and one in each corner of the opening.",
        "construction": "InTheRound",
        "piece": "piece-2",
        "steps": [
          {
            "id": "step-13",
            "action": {
              "Join": {
                "source": {
                  "Held": "step-5"
                },
                "stitch": "Knit",
                "resolve_turns": false
              }
            }
          },
          {
            "id": "step-14",
            "action": {
              "PickUp": {
                "count": 10,
                "along": {
                  "Edge": "the cast-on edge of the thumb opening"
                },
                "group": null
              }
            }
          },
          {
            "id": "step-15",
            "action": {
              "JoinRound": {}
            }
          },
          {
            "id": "step-16",
            "action": {
              "Rows": {
                "count": 14,
                "text": "knit"
              }
            }
          },
          {
            "id": "step-17",
            "action": {
              "Shape": {
                "change": -9,
                "every": 1,
                "until": {
                  "Remain": 9
                },
                "groups": [],
                "text": "k2tog around"
              }
            }
          },
          {
            "id": "step-18",
            "action": {
              "Opaque": {
                "text": "Break the yarn, draw it through the remaining 9 sts and pull tight.",
                "stitch_change": -9
              }
            }
          }
