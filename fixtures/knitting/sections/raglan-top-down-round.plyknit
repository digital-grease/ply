    "notes": "Worked from the neck down in the round. The round starts at the right back raglan line: the back, the left sleeve, the front, then the right sleeve.",
    "sections": [
      {
        "id": "section-1",
        "name": "Neckband",
        "notes": "",
        "construction": "InTheRound",
        "piece": null,
        "steps": [
          {
            "id": "step-1",
            "action": {
              "ChartRows": {
                "first": 1,
                "last": 1
              }
            }
          },
          {
            "id": "step-2",
            "action": {
              "Rows": {
                "count": 7,
                "text": "k2, p2 rib as set"
              }
            }
          }
        ]
      },
      {
        "id": "section-2",
        "name": "Raglan yoke",
        "notes": "Place a marker at each raglan line: after 32 sts (back), 16 (left sleeve), 32 (front) and 16 (right sleeve).",
        "construction": "InTheRound",
        "piece": "piece-1",
        "steps": [
          {
            "id": "step-3",
            "action": {
              "Shape": {
                "change": 8,
                "every": 2,
                "until": {
                  "Times": 16
                },
                "groups": [],
                "text": "*knit to 1 st before the next marker, m1r, k1, slip the marker, k1, m1l; rep from * 3 more times"
              }
            }
          }
        ]
      },
      {
        "id": "section-3",
        "name": "Dividing round",
        "notes": "Each sleeve's stitches go on hold, and 8 underarm stitches are cast on in their place; the right sleeve's are the last of the round.",
        "construction": "InTheRound",
        "piece": "piece-1",
        "steps": [
          {
            "id": "step-4",
            "action": {
              "Work": {
                "stitch": "Knit",
                "to": {
                  "Count": 64
                },
                "resolve_turns": false
              }
            }
          },
          {
            "id": "step-5",
            "action": {
              "Hold": {
                "count": 48,
                "name": "left sleeve"
              }
            }
          },
          {
            "id": "step-6",
            "action": {
              "CastOn": {
                "count": 8
              }
            }
          },
          {
            "id": "step-7",
            "action": {
              "Work": {
                "stitch": "Knit",
                "to": {
                  "Count": 64
                },
                "resolve_turns": false
              }
            }
          },
          {
            "id": "step-8",
            "action": {
              "Hold": {
                "count": null,
                "name": "right sleeve"
              }
            }
          },
          {
            "id": "step-9",
            "action": {
              "CastOn": {
                "count": 8
              }
            }
          }
        ]
      },
      {
        "id": "section-4",
        "name": "Body",
        "notes": "",
        "construction": "InTheRound",
        "piece": "piece-1",
        "steps": [
          {
            "id": "step-10",
            "action": {
              "Rows": {
                "count": 60,
                "text": "knit"
              }
            }
          },
          {
            "id": "step-11",
            "action": {
              "Rows": {
                "count": 12,
                "text": "k2, p2 rib"
              }
            }
          },
          {
            "id": "step-12",
            "action": {
              "BindOff": {
                "count": null,
                "resolve_turns": false
              }
            }
          }
        ]
      },
      {
        "id": "section-5",
        "name": "Left sleeve",
        "notes": "The round starts at the center of the underarm.",
        "construction": "InTheRound",
        "piece": "piece-2",
        "steps": [
          {
            "id": "step-13",
            "action": {
              "PickUp": {
                "count": 4,
                "along": {
                  "Edge": "the underarm cast-on, from its center"
                },
                "group": null
              }
            }
          },
          {
            "id": "step-14",
            "action": {
              "Join": {
                "source": {
                  "Held": "step-5"
                },
                "stitch": "Knit",
                "resolve_turns": false
              }
            }
          },
          {
            "id": "step-15",
            "action": {
              "PickUp": {
                "count": 4,
                "along": {
                  "Edge": "the underarm cast-on, to its center"
                },
                "group": null
              }
            }
          },
          {
            "id": "step-16",
            "action": {
              "JoinRound": {}
            }
          },
          {
            "id": "step-17",
            "action": {
              "Shape": {
                "change": -2,
                "every": 8,
                "until": {
                  "Remain": 40
                },
                "groups": [],
                "text": "k1, k2tog, knit to last 3 sts, ssk, k1"
              }
            }
          },
          {
            "id": "step-18",
            "action": {
              "Rows": {
                "count": 10,
                "text": "k2, p2 rib"
              }
            }
          },
          {
            "id": "step-19",
            "action": {
              "BindOff": {
                "count": null,
                "resolve_turns": false
              }
            }
          }
        ]
      },
