{
  "description": "Each band is the same two-card, two-pick band (card 1 S, card 2 Z, both at Ply home, turned FF twice) with one defect. 'refused': validation lists exactly these diagnostics (code, severity, typed location) and simulation is refused with the same errors. 'simulates': validation lists exactly these diagnostics and the band simulates. 'unreadable': the band does not deserialize through the engine's strict band shape. Written by hand from the rules.",
  "cases": [
    {"file": "start-diagonal-on-edge.band.json", "tests": "two diagonal holes on one edge (A at NT, C at FT)", "outcome": "refused", "diagnostics": [{"code": "tablet.start_illegal", "severity": "error", "location": {"kind": "card", "card": 2}}]},
    {"file": "start-repeated-hole.band.json", "tests": "a repeated letter (A at NT and at FT, no D)", "outcome": "refused", "diagnostics": [{"code": "tablet.start_illegal", "severity": "error", "location": {"kind": "card", "card": 1}}]},
    {"file": "turns-one-card-short.band.json", "tests": "a turn string one card short", "outcome": "refused", "diagnostics": [{"code": "tablet.turns_length", "severity": "error", "location": {"kind": "step", "segment": 1, "step": 2, "card": null}}]},
    {"file": "turn-unknown-letter.band.json", "tests": "an unknown turn letter", "outcome": "refused", "diagnostics": [{"code": "tablet.turn_letter", "severity": "error", "location": {"kind": "step", "segment": 1, "step": 1, "card": 2}}]},
    {"file": "turn-half-turn-digit.band.json", "tests": "a \"2\" style half turn, refused with a pointer to the ? marker", "outcome": "refused", "diagnostics": [{"code": "tablet.turn_letter", "severity": "error", "location": {"kind": "step", "segment": 1, "step": 1, "card": 1}, "remediation_contains": "mark the card ?"}]},
    {"file": "unsupported-without-words.band.json", "tests": "? without the pattern's words", "outcome": "refused", "diagnostics": [{"code": "tablet.unsupported_text", "severity": "error", "location": {"kind": "step", "segment": 1, "step": 1, "card": 1}}]},
    {"file": "words-without-mark.band.json", "tests": "the pattern's words for a card not marked ?", "outcome": "refused", "diagnostics": [{"code": "tablet.unsupported_text", "severity": "error", "location": {"kind": "step", "segment": 1, "step": 1, "card": 2}}]},
    {"file": "words-for-unknown-card.band.json", "tests": "the pattern's words for a card that is not in the band", "outcome": "refused", "diagnostics": [{"code": "tablet.card_ref", "severity": "error", "location": {"kind": "step", "segment": 1, "step": 1, "card": null}}]},
    {"file": "flip-unknown-card.band.json", "tests": "a flip naming an unknown card", "outcome": "refused", "diagnostics": [{"code": "tablet.card_ref", "severity": "error", "location": {"kind": "step", "segment": 1, "step": 2, "card": null}}]},
    {"file": "release-unknown-card.band.json", "tests": "a twist release naming an unknown card", "outcome": "refused", "diagnostics": [{"code": "tablet.card_ref", "severity": "error", "location": {"kind": "step", "segment": 1, "step": 2, "card": null}}]},
    {"file": "flip-card-twice.band.json", "tests": "one flip list naming a card twice", "outcome": "refused", "diagnostics": [{"code": "tablet.card_ref", "severity": "error", "location": {"kind": "step", "segment": 1, "step": 2, "card": 1}}]},
    {"file": "pack-unknown-card.band.json", "tests": "a pack naming an unknown card", "outcome": "refused", "diagnostics": [{"code": "tablet.card_ref", "severity": "error", "location": {"kind": "pack", "pack": 1}}]},
    {"file": "palette-out-of-range.band.json", "tests": "a palette index out of range", "outcome": "refused", "diagnostics": [{"code": "tablet.palette_ref", "severity": "error", "location": {"kind": "hole", "card": 2, "hole": "B"}}]},
    {"file": "repeat-zero.band.json", "tests": "a segment repeated 0 times", "outcome": "refused", "diagnostics": [{"code": "tablet.repeat_zero", "severity": "error", "location": {"kind": "segment", "segment": 2}}]},
    {"file": "repeats-past-the-cap.band.json", "tests": "repeats that expand to 200,002 picks, past the 200,000 cap, refused before allocating", "outcome": "refused", "diagnostics": [{"code": "tablet.too_large", "severity": "error", "location": {"kind": "band"}}]},
    {"file": "repeats-past-u32.band.json", "tests": "repeats that expand to 8,589,934,590 picks, more than a u32 holds, refused before allocating", "outcome": "refused", "diagnostics": [{"code": "tablet.too_large", "severity": "error", "location": {"kind": "band"}}]},
    {"file": "duplicate-card-id.band.json", "tests": "two cards with one id", "outcome": "refused", "diagnostics": [{"code": "tablet.duplicate_id", "severity": "error", "location": {"kind": "cards", "cards": {"cards": [1, 2], "total": 2}}}]},
    {"file": "pack-overlap.band.json", "tests": "a card in two packs: a warning, the band still simulates", "outcome": "simulates", "diagnostics": [{"code": "tablet.pack_overlap", "severity": "warning", "location": {"kind": "pack_card", "card": 2, "packs": {"packs": [1, 2], "total": 2}, "listings": 2}}]},
    {"file": "pack-lists-card-twice.band.json", "tests": "one pack listing a card twice: a warning, the band still simulates", "outcome": "simulates", "diagnostics": [{"code": "tablet.pack_overlap", "severity": "warning", "location": {"kind": "pack_card", "card": 1, "packs": {"packs": [1], "total": 1}, "listings": 2}}]},
    {"file": "card-id-invalid.band.json", "tests": "a card id with a space (ids are [A-Za-z0-9][A-Za-z0-9_-]{0,63})", "outcome": "refused", "diagnostics": [{"code": "tablet.id_invalid", "severity": "error", "location": {"kind": "card", "card": 2}}]},
    {"file": "pack-id-invalid.band.json", "tests": "a pack id starting with '-'", "outcome": "refused", "diagnostics": [{"code": "tablet.id_invalid", "severity": "error", "location": {"kind": "pack", "pack": 1}}]},
    {"file": "unknown-field.band.json", "tests": "an unknown field (refused by the strict band reader)", "outcome": "unreadable"},
    {"file": "missing-hole-key.band.json", "tests": "a card's threads without hole D (all four keys are required; null is an empty hole)", "outcome": "unreadable"},
    {"file": "unknown-threading-letter.band.json", "tests": "an unknown threading letter (refused by the strict band reader)", "outcome": "unreadable"}
  ]
}
