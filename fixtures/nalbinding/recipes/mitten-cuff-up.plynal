{"format":"ply.nalbind","schemaVersion":3,"name":"Cuff-up mittens","notation":"UO/UOO F1","stitchName":"Oslo","notes":"Wool, about 40 g for one mitten. Work both mittens of a pair at the same time so they match.","recipe":{"fit":[{"label":"Hand around the knuckles","value":19.0,"unit":"cm"},{"label":"Wrist to fingertip","value":18.0,"unit":"cm"}],"segments":[{"id":"segment-1","title":"Cuff start","work":{"kind":"foundationChain","stitches":36,"join":"ring"},"stitch":{"notation":"UO/UOO F2","name":"Oslo, F2 connection","reading":"strict"},"target":null,"notes":"The ring has to pass over the widest part of the hand, so try it before joining.","caution":"Do not twist the chain when you join it."},{"id":"segment-2","title":"Cuff","work":{"kind":"rounds","worked":"spiral","extent":{"type":"rounds","count":8}},"stitch":{"notation":"UO/UOO F2","name":"Oslo, F2 connection","reading":"strict"},"target":null,"notes":"The F2 connection makes the cuff denser than the hand.","caution":""},{"id":"segment-3","title":"Hand","work":{"kind":"rounds","worked":"spiral","extent":{"type":"until","measure":{"label":"from the cuff edge","value":7.0,"unit":"cm"}}},"stitch":null,"target":null,"notes":"Try it on: the work should reach the base of the thumb.","caution":""},{"id":"segment-4","title":"Thumb opening","work":{"kind":"opening","skip":7,"stitches":9},"stitch":null,"target":null,"notes":"","caution":"Keep the stitches across the gap a little loose so the thumb has room."},{"id":"segment-5","title":"Upper hand","work":{"kind":"rounds","worked":"spiral","extent":{"type":"until","measure":{"label":"it reaches the tip of the little finger","value":null,"unit":null}}},"stitch":null,"target":null,"notes":"","caution":""},{"id":"segment-6","title":"Top","work":{"kind":"decrease","perRound":4,"method":"twoLoopsAtOnce","extent":{"type":"untilStitches","count":10}},"stitch":null,"target":null,"notes":"Spread the decreases evenly, and put them in the same places on both mittens.","caution":""},{"id":"segment-7","title":"Close the top","work":{"kind":"finish","method":"closeTip"},"stitch":null,"target":null,"notes":"Pass the end through the last loops, pull them together and darn the end in on the inside.","caution":""},{"id":"segment-8","title":"Thumb","work":{"kind":"pickUp","from":"segment-4","stitches":18},"stitch":null,"target":null,"notes":"Start at a lower corner of the opening; an extra loop at each corner keeps holes away.","caution":""},{"id":"segment-9","title":"Thumb rounds","work":{"kind":"rounds","worked":"spiral","extent":{"type":"until","measure":{"label":"it covers half of the thumb nail","value":null,"unit":null}}},"stitch":null,"target":null,"notes":"","caution":""},{"id":"segment-10","title":"Thumb tip","work":{"kind":"decrease","perRound":3,"method":"twoLoopsAtOnce","extent":{"type":"untilStitches","count":6}},"stitch":null,"target":null,"notes":"","caution":""},{"id":"segment-11","title":"Close the thumb","work":{"kind":"finish","method":"closeTip"},"stitch":null,"target":null,"notes":"","caution":""}],"done":[],"lastSegmentNumber":11}}