{"format":"ply.nalbind","schemaVersion":3,"name":"Crown-down hat","notation":"UOO/UUOO F2","stitchName":"Mammen","notes":"Worked from the crown to the brim, trying it on as it grows.","recipe":{"fit":[{"label":"Head around the forehead","value":56.0,"unit":"cm"}],"segments":[{"id":"segment-1","title":"Crown","work":{"kind":"centreStart","stitches":8},"stitch":null,"target":null,"notes":"Pull the starting ring tight before the second round.","caution":""},{"id":"segment-2","title":"Crown increases","work":{"kind":"increase","perRound":8,"method":"sameLoopTwice","extent":{"type":"rounds","count":4}},"stitch":null,"target":{"label":"Across the crown","value":10.0,"unit":"cm"},"notes":"","caution":""},{"id":"segment-3","title":"Crown, slower","work":{"kind":"increase","perRound":4,"method":"sameLoopTwice","extent":{"type":"until","measure":{"label":"across the crown","value":17.0,"unit":"cm"}}},"stitch":null,"target":null,"notes":"","caution":"If the edge ruffles, increase less often; if it cups, increase more often."},{"id":"segment-4","title":"Sides","work":{"kind":"rounds","worked":"spiral","extent":{"type":"until","measure":{"label":"from the crown edge","value":14.0,"unit":"cm"}}},"stitch":null,"target":null,"notes":"No more increases: the sides go straight down.","caution":""},{"id":"segment-5","title":"Brim","work":{"kind":"rounds","worked":"spiral","extent":{"type":"rounds","count":4}},"stitch":{"notation":"UOO/UUOO F1","name":"Korgen","reading":"strict"},"target":null,"notes":"The same needle path with an F1 connection; try a few rounds on a swatch first.","caution":""},{"id":"segment-6","title":"Brim edge","work":{"kind":"finish","method":"taperEdge"},"stitch":null,"target":null,"notes":"","caution":"Taper over several stitches so the step at the end of the spiral is gentle."},{"id":"segment-7","title":"Care","work":{"kind":"freeform","role":"other","text":"Wash gently and dry flat over a bowl to shape the crown."},"stitch":null,"target":null,"notes":"","cauti